# Pinned DXVK inputs for scripts/ci/build-android.sh. The CI cache for the DXVK build is keyed on
# this file and dxvk-android.patch, so bump something here when the DXVK build itself changes.

# fbraz3's GeneralsX DXVK 2.6 fork: the same commit engine/cmake/dx8.cmake pins for macOS.
DXVK_REPO=https://github.com/fbraz3/dxvk.git
DXVK_COMMIT=46a3bc018bcae408d49d3c500e4e536a11f6789a
# DXVK only needs SDL3's headers (it dlopen()s libSDL3.so); same release as engine/cmake/sdl3.cmake.
SDL3_VERSION=3.4.2
SDL3_SHA256=ef39a2e3f9a8a78296c40da701967dd1b0d0d6e267e483863ce70f8a03b4050c
