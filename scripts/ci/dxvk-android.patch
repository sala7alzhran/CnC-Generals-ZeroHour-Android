+  Rc<DxvkImageView> DxvkUnboundResources::createNullImage(
+          DxvkContext*        ctx,
+          VkImageType         type,
+          VkImageViewType     viewType,
+          uint32_t            layers,
+          VkImageCreateFlags  flags,
+          VkImageUsageFlags   viewUsage,
+          Rc<DxvkImage>&      image) {
+    DxvkImageCreateInfo info;
+    info.type        = type;
+    info.format      = VK_FORMAT_R8G8B8A8_UNORM;
+    info.flags       = flags;
+    info.sampleCount = VK_SAMPLE_COUNT_1_BIT;
+    info.extent      = { 1u, 1u, 1u };
+    info.numLayers   = layers;
+    info.mipLevels   = 1u;
+    info.usage       = VK_IMAGE_USAGE_TRANSFER_DST_BIT | viewUsage;
+    info.stages      = VK_PIPELINE_STAGE_TRANSFER_BIT
+                     | m_device->getShaderPipelineStages();
+    info.access      = VK_ACCESS_SHADER_READ_BIT;
+    info.tiling      = VK_IMAGE_TILING_OPTIMAL;
+    info.layout      = VK_IMAGE_LAYOUT_GENERAL;
+    info.debugName   = "Null image";
+
+    image = m_device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    // Clear to zero and move to the GENERAL layout
+    ctx->initImage(image, image->getAvailableSubresources(), VK_IMAGE_LAYOUT_UNDEFINED);
+
+    DxvkImageViewKey key;
+    key.viewType      = viewType;
+    key.usage         = viewUsage;
+    key.format        = VK_FORMAT_R8G8B8A8_UNORM;
+    key.aspects       = VK_IMAGE_ASPECT_COLOR_BIT;
+    key.mipIndex      = 0u;
+    key.mipCount      = 1u;
+    key.layerIndex    = 0u;
+    key.layerCount    = layers;
+    key.packedSwizzle = 0u;
+
+    return image->createView(key);
+  }
