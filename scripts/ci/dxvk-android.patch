+
+  void DxvkUnboundResources::createNullDescriptorResources(DxvkContext* ctx) {
+    if (m_device->features().extRobustness2.nullDescriptor)
+      return;
+
+    // Create the dummy buffer first, bufferHandle() takes the lock itself
+    bufferHandle();
+
+    std::lock_guard lock(m_mutex);
+
+    if (m_nullDescriptorResourcesCreated)
+      return;
+
+    m_nullDescriptorResourcesCreated = true;
+
+    // Texel buffer view over the zero-filled dummy buffer. R32_UINT has
+    // mandatory uniform and storage texel buffer support.
+    DxvkBufferViewKey bufferViewKey;
+    bufferViewKey.format = VK_FORMAT_R32_UINT;
+    bufferViewKey.usage  = VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT
+                         | VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT;
+    bufferViewKey.offset = 0u;
+    bufferViewKey.size   = m_buffer->info().size;
+
+    m_bufferView = m_buffer->createView(bufferViewKey);
+    m_bufferViewHandle = m_bufferView->handle();
+
+    // 1x1 zero-filled images. The 2D one is cube-compatible with six layers
+    // so that it can back 2D, 2D array, cube and cube array views.
+    bool storage2D = m_device->adapter()->getFormatFeatures(VK_FORMAT_R8G8B8A8_UNORM).optimal
+      & VK_FORMAT_FEATURE_2_STORAGE_IMAGE_BIT;
+
+    VkImageUsageFlags usage2D = VK_IMAGE_USAGE_SAMPLED_BIT
+      | (storage2D ? VK_IMAGE_USAGE_STORAGE_BIT : 0u);
+
+    m_imageViews[0] = createNullImage(ctx, VK_IMAGE_TYPE_1D,
+      VK_IMAGE_VIEW_TYPE_1D_ARRAY, 1u, 0u, VK_IMAGE_USAGE_SAMPLED_BIT, m_images[0]);
+    m_imageViews[1] = createNullImage(ctx, VK_IMAGE_TYPE_2D,
+      VK_IMAGE_VIEW_TYPE_2D_ARRAY, 6u, VK_IMAGE_CREATE_CUBE_COMPATIBLE_BIT, usage2D, m_images[1]);
+    m_imageViews[2] = createNullImage(ctx, VK_IMAGE_TYPE_3D,
+      VK_IMAGE_VIEW_TYPE_3D, 1u, 0u, VK_IMAGE_USAGE_SAMPLED_BIT, m_images[2]);
+
+    // Create all view handles up front so that later lookups are read-only
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_1D]       = m_imageViews[0]->handle(VK_IMAGE_VIEW_TYPE_1D);
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_1D_ARRAY] = m_imageViews[0]->handle(VK_IMAGE_VIEW_TYPE_1D_ARRAY);
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_2D]       = m_imageViews[1]->handle(VK_IMAGE_VIEW_TYPE_2D);
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_2D_ARRAY] = m_imageViews[1]->handle(VK_IMAGE_VIEW_TYPE_2D_ARRAY);
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_CUBE]     = m_imageViews[1]->handle(VK_IMAGE_VIEW_TYPE_CUBE);
+    m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_3D]       = m_imageViews[2]->handle(VK_IMAGE_VIEW_TYPE_3D);
+
+    if (m_device->features().core.features.imageCubeArray)
+      m_sampledViewHandles[VK_IMAGE_VIEW_TYPE_CUBE_ARRAY] = m_imageViews[1]->handle(VK_IMAGE_VIEW_TYPE_CUBE_ARRAY);
+
+    if (storage2D) {
