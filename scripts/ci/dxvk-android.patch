+  VkDescriptorBufferInfo DxvkUnboundResources::bufferDescriptor() {
+    // Make sure the buffer exists; m_buffer is written before the
+    // handle is published, so it is safe to read afterwards.
+    bufferHandle();
+
+    DxvkBufferSliceHandle slice = m_buffer->getSliceHandle();
+
+    VkDescriptorBufferInfo result = { };
+    result.buffer = slice.handle;
+    result.offset = slice.offset;
+    result.range  = slice.length;
+    return result;
+  }
