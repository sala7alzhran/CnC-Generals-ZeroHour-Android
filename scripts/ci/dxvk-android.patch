diff --git a/meson.build b/meson.build
index 26afed4..7c6a555 100644
--- a/meson.build
+++ b/meson.build
@@ -137,6 +137,11 @@ else
     dxvk_version += [ padded ]
   endforeach
   dxvk_so_version = {'version': dxvk_abi_version + '.' + dxvk_version[0] + dxvk_version[1] + dxvk_version[2]}
+  if cpp.get_define('__ANDROID__') != ''
+    # Android: the APK can only carry plain lib*.so files and the loader resolves
+    # DT_NEEDED by file name, so build unversioned libdxvk_d3d9.so / libdxvk_d3d8.so.
+    dxvk_so_version = {}
+  endif
 
   wrc           = find_program('touch')
   wrc_generator = generator(wrc, output : [ '@BASENAME@_ignored.h' ], arguments : [ '@OUTPUT@' ] )
diff --git a/src/d3d9/d3d9_interface.cpp b/src/d3d9/d3d9_interface.cpp
index f0c0921..a211ba2 100644
--- a/src/d3d9/d3d9_interface.cpp
+++ b/src/d3d9/d3d9_interface.cpp
@@ -394,8 +394,17 @@ namespace dxvk {
 
       hr = device->InitialReset(pPresentationParameters, pFullscreenDisplayMode);
 
-      if (unlikely(FAILED(hr)))
+      if (unlikely(FAILED(hr))) {
+#ifdef __ANDROID__
+        // Destroy the half-initialised device now. Its implicit swapchain already owns a
+        // VkSurfaceKHR on the window, and Android allows one producer per ANativeWindow, so
+        // leaking it makes every later surface creation on that window fail (-22 / OOM).
+        // The destructor waits for the device and destroys the swapchain and surface.
+        device->AddRef();
+        device->Release();
+#endif
         return hr;
+      }
 
       *ppReturnedDeviceInterface = ref(device);
     }
