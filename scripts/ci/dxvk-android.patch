+    // Emit the actual draw call. Android: without multiDrawIndirect
+    // (older Mali), issue one indirect draw per text draw instead.
+    if (likely(m_device->features().core.features.multiDrawIndirect)) {
+      ctx.cmd->cmdDrawIndirect(drawArgs.buffer, drawArgs.offset,
+        drawCount, sizeof(VkDrawIndirectCommand));
+    } else {
+      for (uint32_t i = 0; i < drawCount; i++) {
+        ctx.cmd->cmdDrawIndirect(drawArgs.buffer,
+          drawArgs.offset + i * sizeof(VkDrawIndirectCommand),
+          1u, sizeof(VkDrawIndirectCommand));
+      }
+    }
